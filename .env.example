PORT=3000
MASTER_ADMIN_KEY=change-me-to-a-long-random-secret
SESSIONS_PATH=/data/sessions

# --- Modo de deploy ---
# allinone = 1 VPS barato (API + Postgres no Compose)  ← recomendado se DO ficou caro
# managed  = só API + Managed Database (DigitalOcean)
DEPLOY_MODE=allinone

# --- Banco ---
# Modo barato / local (postgres do docker-compose.yml):
DATABASE_URL=postgres://montwhats:montwhats@postgres:5432/montwhats
DATABASE_SSL=false

# Modo managed (cole a URI do painel DO e use DEPLOY_MODE=managed):
# DATABASE_URL=postgresql://doadmin:SUA_SENHA@SEU_HOST.db.ondigitalocean.com:25060/defaultdb?sslmode=require
# DATABASE_SSL=true
# DATABASE_CA_PATH=/certs/ca-certificate.crt

# --- HTTPS opcional (hoje no compose.prod / modo managed) ---
# DOMAIN=whats.seudominio.com

# Anti-ban defaults
ANTIBAN_JITTER_MIN_MS=3000
ANTIBAN_JITTER_MAX_MS=15000
ANTIBAN_COMPOSING_MS=1200
ANTIBAN_WARMUP_PHASE1_DAILY=30
ANTIBAN_WARMUP_PHASE2_DAILY=80
ANTIBAN_WARMUP_PHASE3_DAILY=180
ANTIBAN_HOURLY_CAP=25
ANTIBAN_BLAST_SAME_TEXT_LIMIT=5
ANTIBAN_BLAST_WINDOW_MS=600000
ANTIBAN_COLD_CONTACT_STREAK=8
